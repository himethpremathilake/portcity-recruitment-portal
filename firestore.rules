rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if the requesting user is in the portal users collection
    function isPortalUser() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    // Check if requester is a super admin
    function isSuperAdmin() {
      return request.auth != null &&
             (request.auth.token.email == "portcitybpo26@gmail.com" ||
              request.auth.token.email == "gayathri@portcitybpo.lk");
    }

    // Check if requester is Super Admin PCBPO CT
    function isSuperAdminPCBPOCT() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'Super Admin PCBPO CT';
    }

    // Requisitions: any portal user can read/write
    match /requisitions/{id} {
      allow read, write: if isPortalUser() || isSuperAdmin();
    }

    // Notifications: any portal user can read/write their own
    match /notifications/{id} {
      allow read, write: if isPortalUser() || isSuperAdmin();
    }

    // Settings: any portal user can read; only HR/admin can write (enforced in app)
    match /settings/{doc} {
      allow read: if isPortalUser() || isSuperAdmin();
      allow write: if isPortalUser() || isSuperAdmin();
    }

    // Users: allow unauthenticated reads so the login screen can check the
    // access list before creating a first-time password (data: name/email/role/div only)
    match /users/{email} {
      allow read: if true;
      // Super admins can manage users; also allow self-creation on first login
      allow create: if isSuperAdmin() || isSuperAdminPCBPOCT() ||
                       (request.auth != null && request.auth.token.email == email);
      allow update: if isSuperAdmin() || isSuperAdminPCBPOCT() || isPortalUser();
      allow delete: if isSuperAdmin() || isSuperAdminPCBPOCT();
    }
  }
}
